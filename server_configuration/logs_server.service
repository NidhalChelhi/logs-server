[Unit]
Description=Log Server API
After=network.target
StartLimitIntervalSec=60

[Service]
Type=simple
User=root
WorkingDirectory=/root/logs_server
ExecStart=/usr/bin/python3 /root/logs_server/main.py
Restart=always
RestartSec=5
TimeoutStopSec=10
KillMode=process
Environment=PYTHONUNBUFFERED=1

# Security
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=/var/log/remote

[Install]
WantedBy=multi-user.target
